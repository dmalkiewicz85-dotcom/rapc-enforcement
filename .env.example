# Copy to .env.local. Never commit .env.local. Full setup: docs/SETUP_GOOGLE.md
#
# Everything the app does in Google happens as this one account, via a refresh
# token obtained with `npm run google:authorize`. All of these are server-only —
# never prefix any with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_FOLDER_ID=
HOA_ENFORCEMENT_EMAIL=rapchoa@gmail.com

# Go-live only (docs/TODO.md #7)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
